# ==========================================
# PhotoArchiver Environment
# ==========================================
# Copy this file to ".env" and adjust values for local development.

# ---------- Application ----------
APP_NAME=PhotoArchiver
APP_VERSION=2.5.0
ENV=development
DEBUG=true

# ---------- Logging ----------
# Supported levels: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
# When DEBUG=true and LOG_LEVEL is omitted, logging defaults to DEBUG.
# 未配置 LOG_DIRECTORY 时默认锚定用户日志目录（ADR-035）。
LOG_LEVEL=DEBUG
LOG_DIRECTORY=logs

# ---------- Storage ----------
# 未配置 DATABASE_URL 时默认锚定用户数据目录（ADR-035）：Windows
# %LOCALAPPDATA%\PhotoArchiver、macOS ~/Library/Application Support、Linux
# ~/.local/share——任意目录启动均命中同一份库。以下为显式示例：相对路径仍
# 随启动目录变化（v2.4.0 起首次迁移引导会提示旧 CWD 库）。
DATABASE_URL=sqlite:///data/photo_archiver.db
MODEL_PATH=resources/models
PHOTO_ROOT=
OUTPUT_ROOT=

# ---------- Archive ----------
# Root directory for archived photos. Naming rule:
#   {ARCHIVE_ROOT}/{person_name}/{event_or_date}/{original_name}
# event_or_date comes from Photo.captured_at (EXIF DateTimeOriginal, fallback mtime).
ARCHIVE_ROOT=
# Conflict strategy when target file already exists:
#   skip       — leave the existing target untouched, mark photo as SKIPPED
#   overwrite  — replace the existing target with the source bytes
#   rename     — write to a sibling with a .dup-N suffix (x.jpg -> x.dup-1.jpg)
ARCHIVE_CONFLICT_STRATEGY=skip

# ---------- AI ----------
# Face match confidence threshold, range [0.0, 1.0]. Candidates below this
# value are not considered a match (Step 10, ADR-017 Top-1 strategy).
MATCH_THRESHOLD=0.40

# ---------- Runtime ----------
MAX_WORKERS=4

# ---------- Image safety (P2-002) ----------
# Decompression-bomb guard: maximum pixels allowed for a single image decode.
# Images above this limit are refused with a clear per-photo error instead of
# exhausting memory. Keep a finite value; the guard must never be disabled.
MAX_IMAGE_PIXELS=89478485
